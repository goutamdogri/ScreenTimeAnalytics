# ------------------------------------------------------------------
# Screen Time Analytics — environment template
# Copy this file to `.env` at the repository root and adjust.
# All values are read from the environment; this file feeds both the
# backend process and the Docker Compose (dev) / prod-compose (VPS)
# stacks. Never commit a real `.env`.
# ------------------------------------------------------------------

# --- Postgres connection (used by Prisma CLI, backend, and Docker Compose) ---
# Local dev: postgresql://screen:screen@localhost:5432/screen_time?schema=public
# Managed cloud (Render/GCP/…): the provider's connection string (same format).
DATABASE_URL=postgresql://screen:screen@localhost:5432/screen_time?schema=public

# --- JWT authentication (REQUIRED in production) ---
# Generate strong secrets, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-strong-access-secret
JWT_REFRESH_SECRET=change-me-strong-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Server ---
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed CORS origins (add the deployed Desktop UI /
# future web client URL in cloud deployments).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Postgres credential overrides for Docker Compose ---
POSTGRES_USER=screen
POSTGRES_PASSWORD=screen
POSTGRES_DB=screen_time
POSTGRES_PORT=5432

# --- Application-level encryption master key (REQUIRED in production) ---
# Used for AES-256-GCM at-rest encryption of user LLM API keys (design doc §3.3).
# Inject this from your cloud provider's secret store (Render encrypted env
# values, VPS `.env` chmod 600, any KMS that exports env) — never commit it.
# Generate with: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=change-me-32-byte-base64-master-key

# --- Content classification (design doc §3.3) ---
# Local Ollama instance the backend probes for provider availability.
LLM_OLLAMA_URL=http://localhost:11434
# Set to 1 to disable the async content-classification worker.
CLASSIFICATION_WORKER_DISABLED=0
# Worker polling interval and batch size for uncategorized events.
CLASSIFICATION_POLL_MS=30000
CLASSIFICATION_BATCH_SIZE=50

# --- Backups (scripts/backup.sh) ---
# Directory for `pg_dump` output. Defaults to ./backups at the repo root.
# BACKUPS_DIR=./backups