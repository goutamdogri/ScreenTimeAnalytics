# ------------------------------------------------------------------
# Screen Time Analytics — environment template
# Copy this file to `.env` at the repository root and adjust.
# ------------------------------------------------------------------

# --- Postgres connection (used by Prisma CLI, backend, and Docker Compose) ---
DATABASE_URL=postgresql://screen:screen@localhost:5432/screen_time?schema=public

# --- JWT authentication ---
# Generate strong secrets, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-strong-access-secret
JWT_REFRESH_SECRET=change-me-strong-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Server ---
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Postgres credential overrides for Docker Compose ---
POSTGRES_USER=screen
POSTGRES_PASSWORD=screen
POSTGRES_DB=screen_time
POSTGRES_PORT=5432

# --- Application-level encryption master key (used from Phase 3 for LLM API keys) ---
# Generate with `openssl rand -base64 32`
ENCRYPTION_MASTER_KEY=change-me-32-byte-base64-master-key

# --- Content classification (Phase 3) ---
# Local Ollama instance the backend probes for provider availability.
LLM_OLLAMA_URL=http://localhost:11434
# Set to 1 to disable the async content-classification worker.
CLASSIFICATION_WORKER_DISABLED=0
# Worker polling interval and batch size for uncategorized events.
CLASSIFICATION_POLL_MS=30000
CLASSIFICATION_BATCH_SIZE=50