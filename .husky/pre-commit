branch=$(git branch --show-current)

if [ "$branch" = "main" ]; then
	echo "❌ Direct commits to main are not allowed."
	echo "Please create a new branch and submit a pull request."
	exit 1
fi

pnpm typecheck
# --concurrent=1 serializes the prettier and eslint passes so their combined
# memory stays under the machine's limit (both runs of a large staged set
# used to get OOM-killed otherwise).
pnpm lint-staged --concurrent=1